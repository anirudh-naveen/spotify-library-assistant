# Copy this file to .env and fill in your own values. Never commit .env.

# Client ID from your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=paste_your_spotify_client_id_here

# API key from https://www.last.fm/api/account/create
LASTFM_API_KEY=paste_your_lastfm_api_key_here

# Optional. Must match a Redirect URI in your Spotify app settings exactly.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
